# AERC API 保守版本 Dockerfile
# 此版本鎖定所有套件到 2025-07-15 的已驗證版本
# 當套件更新導致問題時，使用此版本確保服務穩定運行

# 鎖定 Python 基礎映像版本
FROM python:3.13.3-alpine3.22

# 設置工作目錄
RUN mkdir app
WORKDIR /app

# 設置環境變數
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="${PATH}:/root/.local/bin"
ENV PYTHONPATH=.

# 安裝系統依賴 - 鎖定版本
RUN apk add --no-cache \
    build-base=0.5-r3 \
    linux-headers=6.14.2-r0 \
    clang-dev=19.1.6-r1 \
    fontconfig=2.15.0-r3 \
    ttf-dejavu=2.37-r3 \
    wqy-zenhei=0.9.45-r4

# 複製套件版本鎖定檔案
COPY requirements-conservative.txt .

# 安裝 Python 依賴 - 鎖定版本
RUN pip install --upgrade pip==25.0.0 \
    && pip install -r requirements-conservative.txt \
    && rm -rf /root/.cache/pip

# 複製專案檔案
COPY migrations .
COPY pyproject.toml .
COPY src/ .

# 暴露端口
EXPOSE 5000

# 啟動指令
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "5000"]
